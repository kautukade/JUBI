{
  "note": "A password generator. There is no loop, so ten characters are ten statements - which is the honest shape of a bounded document: the cost of a click is visible in the document itself. at(pool, rand(32)) picks one byte of the alphabet; the alphabet omits l, o, 0 and 1 because a person has to read it back.",
  "title": "Password",
  "width": 300, "height": 116,
  "grid": { "rows": 2, "cols": 1, "gap": 8, "pad": 10 },
  "vars": { "pool": "abcdefghijkmnpqrstuvwxyz23456789" },
  "widgets": [
    { "kind": "field", "name": "out", "text": "press generate",
      "align": "center", "readonly": true, "row": 0, "col": 0 },
    { "kind": "button", "text": "generate", "name": "go", "row": 1, "col": 0 }
  ],
  "on": [
    { "click": "go", "do": [
      { "set": "out", "to": "at(pool, rand(32))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" },
      { "set": "out", "to": "cat(out, at(pool, rand(32)))" }
    ] }
  ]
}
