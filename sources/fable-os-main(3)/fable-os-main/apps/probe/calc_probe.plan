# Prove the document-authored calculator works on real hardware.
#
#   make EXTRA_CFLAGS='-DFABLEOS_APP_SELFTEST -DFABLEOS_GUI_SELFTEST \
#                      -DFABLEOS_GUI_WATCH_MS=30000'
#   gui/gui_probe.sh apps/probe/calc_probe.plan /tmp/appcalc
#
# The coordinates below are the screen centres the kernel itself printed
# ("app: hit \"7\" win=1 centre=70,511"), computed by the layout rather than by
# hand, so the aim cannot drift when a metric changes. Wait for the GUI watch
# window first: it is the only period in which drivers/input/kbd.c is not racing
# the mouse for 8042 bytes (include/gui.h, DECISION 4).
await gui: watch
wait 2
shot 01-launched
moveto 70 511
click
moveto 225 631
click
moveto 121 511
click
moveto 148 671
click
wait 1
shot 02-seven-plus-eight
wait 2
