# SARA v7 — example only. ONE-CLICK installer generates strong real values.
SARA_VERSION=7.1.1
SARA_SESSION_SECRET=replace-with-a-long-random-secret
SARA_ADMIN_EMAIL=admin@sara.local
SARA_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_12_PLUS_CHARACTER_PASSWORD

# Local Ollama only
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
SARA_PLANNER_MODEL=qwen2.5:7b
SARA_CRITIC_MODEL=glm4:latest
SARA_CODER_MODEL=qwen2.5-coder:7b
SARA_VISION_MODEL=qwen2.5vl:3b
SARA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
SARA_STRICT_LOCAL=true
SARA_REAL_MODE=1
SARA_DEMO_FALLBACK=0
SARA_COOKIE_SECURE=false

# Windows runtime data outside the extracted project folder
SARA_DATA_DIR=%LOCALAPPDATA%\SARA\data
SARA_AGENT_DATA_DIR=%LOCALAPPDATA%\SARA\agent-data
SARA_AGENT_URL=http://127.0.0.1:8765
SARA_AGENT_TOKEN=replace-with-a-long-random-agent-token
SARA_APPROVED_WORKSPACES=%USERPROFILE%\Desktop;%USERPROFILE%\Documents;%USERPROFILE%\Downloads

# Local encrypted vault
SARA_VAULT_KEY=replace-with-a-random-local-key

# Offline multilingual voice
SARA_WHISPER_MODEL=small
SARA_WHISPER_DEVICE=cpu
SARA_WHISPER_COMPUTE=int8
SARA_ALWAYS_ON_VOICE=true
SARA_WAKE_PHRASE=hey sara
SARA_WAKE_WHISPER_MODEL=base

# Owner-only identity
SARA_OWNER_NAME=Kautuk
SARA_OWNER_LOCK=true
SARA_OWNER_FACE=true
SARA_OWNER_CAMERA_INDEX=0
SARA_OWNER_VERIFICATION_TTL=180
SARA_REQUIRE_OWNER_ENROLLMENT=true

# Continuous transparent skill learning
SARA_CONTINUOUS_LEARNING=true
SARA_INTERNET_LEARNING=true
SARA_AUTO_ADD_SAFE_SKILLS=true
SARA_LEARNING_INTERVAL=45

# Reliability and monitoring
SARA_SELF_HEAL=true
SARA_24X7=true
SARA_SAFE_AUTO_REPAIR=true
SARA_SECURITY_MONITOR=true
SARA_SCREEN_AWARENESS=true
SARA_HUMAN_CONVERSATION=true
SARA_CORE_TASK_NAME=SARA v7.1.1 Robust Startup

# Mobile/LAN service listens on private LAN port 3000.
# Do not port-forward it directly to the public internet.
SARA_WEB_URL=http://127.0.0.1:3000
SARA_FLEET_MAIN_URL=http://127.0.0.1:8765
SARA_FLEET_NODE_ID=
SARA_FLEET_MAIN_TOKEN=
