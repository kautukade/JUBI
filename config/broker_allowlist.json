{
  "schema": "sarus.controlbridge.policy.v1",
  "default": "deny",
  "max_request_bytes": 65536,
  "replay_window_seconds": 300,
  "path_scopes": {
    "user_workspace": ["workspace", "outputs", "projects"]
  },
  "forbidden_actions": [
    "powershell",
    "cmd",
    "shell",
    "arbitrary_exec",
    "driver.load",
    "driver.raw_ioctl",
    "kernel.read_memory",
    "kernel.write_memory",
    "kernel.map_physical_memory",
    "security.disable_controls",
    "audit.disable"
  ],
  "resources": {
    "services": {
      "ollama": {"service_name": "Ollama"}
    },
    "processes": {
      "ollama": {"image_name": "ollama.exe"}
    },
    "apps": {
      "vscode": {"argv": ["code"]},
      "notepad": {"argv": ["notepad.exe"]},
      "explorer": {"argv": ["explorer.exe"]}
    }
  },
  "actions": {
    "system.processes.list": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "parameters": {}
    },
    "system.services.list": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "parameters": {}
    },
    "workspace.file.read": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096}
      }
    },
    "workspace.file.write": {
      "enabled": true,
      "risk": 2,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096},
        "content": {"type": "string", "required": true, "max_length": 200000}
      }
    },
    "workspace.path.stat": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096}
      }
    },
    "workspace.directory.list": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096}
      }
    },
    "workspace.directory.create": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096},
        "parents": {"type": "boolean", "required": false}
      }
    },
    "workspace.file.copy": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "source_path": {"type": "string", "required": true, "max_length": 4096},
        "destination_path": {"type": "string", "required": true, "max_length": 4096},
        "overwrite": {"type": "boolean", "required": false}
      }
    },
    "workspace.file.move": {
      "enabled": true,
      "risk": 2,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "source_path": {"type": "string", "required": true, "max_length": 4096},
        "destination_path": {"type": "string", "required": true, "max_length": 4096},
        "overwrite": {"type": "boolean", "required": false}
      }
    },
    "workspace.file.delete": {
      "enabled": true,
      "risk": 4,
      "requires_approval": true,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096}
      }
    },
    "development.git.status": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096}
      }
    },
    "development.git.log": {
      "enabled": true,
      "risk": 0,
      "requires_approval": false,
      "path_scope": "user_workspace",
      "parameters": {
        "path": {"type": "string", "required": true, "max_length": 4096},
        "limit": {"type": "integer", "required": false}
      }
    },
    "app.launch": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "resource_group": "apps",
      "parameters": {
        "resource_id": {"type": "resource_id", "required": true, "max_length": 128},
        "workspace_path": {"type": "string", "required": false, "max_length": 4096}
      }
    },
    "url.open": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "parameters": {
        "url": {"type": "url", "required": true, "max_length": 4096}
      }
    },
    "ring0.ping": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "parameters": {}
    },
    "ring0.status": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "parameters": {}
    },
    "service.query": {
      "enabled": true,
      "risk": 1,
      "requires_approval": false,
      "resource_group": "services",
      "parameters": {
        "resource_id": {"type": "resource_id", "required": true, "max_length": 128}
      }
    },
    "service.start": {
      "enabled": true,
      "risk": 3,
      "requires_approval": true,
      "resource_group": "services",
      "parameters": {
        "resource_id": {"type": "resource_id", "required": true, "max_length": 128}
      }
    },
    "service.stop": {
      "enabled": true,
      "risk": 4,
      "requires_approval": true,
      "resource_group": "services",
      "parameters": {
        "resource_id": {"type": "resource_id", "required": true, "max_length": 128}
      }
    },
    "process.stop": {
      "enabled": true,
      "risk": 4,
      "requires_approval": true,
      "resource_group": "processes",
      "parameters": {
        "resource_id": {"type": "resource_id", "required": true, "max_length": 128},
        "force": {"type": "boolean", "required": false}
      }
    }
  }
}
