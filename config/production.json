{
  "name": "Jubi",
  "version": "0.1.0",
  "foundation": "SARUS 1.3.1",
  "required_models": [],
  "model_selection": "installed-local-role-discovery",
  "model_acquisition": "explicit-user-consent",
  "minimum_python": "3.11",
  "recommended_minimum_ollama": "0.7.0",
  "source_repositories": 10,
  "require_fable_native_layer": false,
  "require_sara_on_windows": false,
  "fable_qemu": "optional-research-lab",
  "ring0": "legacy-controlled-compatibility-bridge-optional-unless-explicitly-certified",
  "localhost_only": true,
  "public_release": {
    "application_authenticode": "required",
    "kernel_driver_microsoft_signing": "required-when-bundled",
    "sha256_artifact": "required"
  },
  "deployment_profiles": {
    "windows_desktop": {
      "supported": true,
      "ui": "local Windows user session",
      "backend_bind": "loopback-only"
    },
    "linux_vps": {
      "supported": true,
      "scope": "core server, local Ollama, research, memory/RAG, vision, Council, executable swarm, bounded autonomous development, read-only JS browser, automations and receipts",
      "backend_bind": "loopback-only",
      "remote_access": "SSH tunnel by default; authenticated TLS reverse proxy only when explicitly configured",
      "service": "systemd",
      "windows_desktop_features": false,
      "recommended_models": {
        "general_and_coding": "qwen3:8b",
        "vision": "qwen2.5vl:3b",
        "embedding": "qwen3-embedding:0.6b"
      },
      "full_profile_flags": [
        "--with-hermes",
        "--with-browser"
      ],
      "full_profile_model_provisioning": "deploy/vps/provision-models.sh --recommended"
    }
  }
}
