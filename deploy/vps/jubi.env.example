# Jubi VPS runtime. Keep the application bound to loopback.
JUBI_HOST=127.0.0.1
JUBI_PORT=8877
JUBI_OLLAMA_URL=http://127.0.0.1:11434
JUBI_DEBUG=0
JUBI_HTTP_LOG=1
JUBI_DEPLOYMENT_PROFILE=linux_vps
JUBI_REQUIRE_HERMES=0
JUBI_REQUIRE_BROWSER=0
JUBI_REQUIRE_FULL_MODELS=0
JUBI_REQUIRE_VOICE=0
SARUS_BROKER_SECRET_FILE=/etc/jubi/broker-approval.secret
JUBI_WHISPER_MODEL=/opt/jubi/.voice/whisper-small
JUBI_WHISPER_DEVICE=cpu
JUBI_WHISPER_COMPUTE_TYPE=int8
PLAYWRIGHT_BROWSERS_PATH=/opt/jubi/.playwright
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONNOUSERSITE=1
